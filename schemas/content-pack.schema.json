{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.hendrickresearch.com/schemas/tinylaps-content-pack-v1.json",
  "title": "TinyLaps content pack, version 1",
  "description": "Plain JSON definitions for miniature maps, racers, and physical scenery. Coordinates and dimensions are in meters. Runtime validation also checks geometry and references.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "name": {"$ref": "#/$defs/name"},
    "description": {"$ref": "#/$defs/description"},
    "maps": {"type": "array", "maxItems": 24, "items": {"$ref": "#/$defs/map"}},
    "cars": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/car"}},
    "props": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/prop"}}
  },
  "anyOf": [
    {"required": ["maps"], "properties": {"maps": {"minItems": 1}}},
    {"required": ["cars"], "properties": {"cars": {"minItems": 1}}},
    {"required": ["props"], "properties": {"props": {"minItems": 1}}}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$"},
    "reference": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}/[a-z][a-z0-9-]{0,47}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "description": {"type": "string", "minLength": 1, "maxLength": 500},
    "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
    "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "point": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "prefixItems": [
        {"type": "number", "minimum": -56, "maximum": 56},
        {"type": "number", "minimum": 0.17, "maximum": 4},
        {"type": "number", "minimum": -38, "maximum": 38}
      ]
    },
    "gridCell": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"type": "integer", "minimum": 0, "maximum": 11}
    },
    "palette": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "grass": {"$ref": "#/$defs/color"}, "sand": {"$ref": "#/$defs/color"},
        "water": {"$ref": "#/$defs/color"}, "sky": {"$ref": "#/$defs/color"},
        "sun": {"$ref": "#/$defs/color"}
      }
    },
    "city": {
      "type": "object", "additionalProperties": false, "required": ["xs", "zs"],
      "properties": {
        "xs": {"type": "array", "minItems": 4, "maxItems": 9, "items": {"type": "number", "minimum": -48, "maximum": 48}},
        "zs": {"type": "array", "minItems": 3, "maxItems": 7, "items": {"type": "number", "minimum": -33, "maximum": 33}},
        "width": {"const": 7, "default": 7},
        "warp": {"type": "number", "minimum": -3, "maximum": 3, "default": 0},
        "parks": {"type": "array", "maxItems": 24, "items": {"$ref": "#/$defs/gridCell"}, "default": []},
        "style": {"enum": ["modern", "historic", "garden"], "default": "modern"},
        "residents": {"type": "integer", "minimum": 0, "maximum": 150, "default": 72},
        "traffic": {"type": "integer", "minimum": 0, "maximum": 40, "default": 20},
        "seed": {"$ref": "#/$defs/seed"}
      }
    },
    "placement": {
      "type": "object", "additionalProperties": false, "required": ["prop", "x", "z"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "prop": {"$ref": "#/$defs/reference"},
        "x": {"type": "number", "minimum": -56, "maximum": 56},
        "z": {"type": "number", "minimum": -38, "maximum": 38},
        "yaw": {"type": "number", "minimum": -6.283185307179586, "maximum": 6.283185307179586, "default": 0}
      }
    },
    "map": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "description"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "name": {"$ref": "#/$defs/name"}, "description": {"$ref": "#/$defs/description"},
        "setting": {"enum": ["harbor", "alpine", "sunset"], "default": "harbor"},
        "difficulty": {"enum": ["Easy", "Flowing", "Fast", "Technical", "City"], "default": "Flowing"},
        "seed": {"$ref": "#/$defs/seed"},
        "routeRevision": {"type": "integer", "minimum": 1, "maximum": 1000000, "default": 1},
        "palette": {"$ref": "#/$defs/palette"},
        "points": {"type": "array", "minItems": 6, "maxItems": 64, "items": {"$ref": "#/$defs/point"}},
        "city": {"$ref": "#/$defs/city"},
        "cityRoute": {"type": "array", "minItems": 6, "maxItems": 64, "items": {"$ref": "#/$defs/gridCell"}},
        "cars": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"$ref": "#/$defs/reference"}},
        "props": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/placement"}}
      },
      "oneOf": [
        {"required": ["points"], "not": {"anyOf": [{"required": ["city"]}, {"required": ["cityRoute"]}]}},
        {"required": ["city", "cityRoute"], "not": {"required": ["points"]}}
      ]
    },
    "personality": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "description", "aggression", "bravery", "defensiveness", "awareness"],
      "properties": {
        "label": {"$ref": "#/$defs/name"}, "description": {"$ref": "#/$defs/description"},
        "aggression": {"type": "number", "minimum": 0, "maximum": 1},
        "bravery": {"type": "number", "minimum": 0, "maximum": 1},
        "defensiveness": {"type": "number", "minimum": 0, "maximum": 1},
        "awareness": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "carModel": {
      "type": "object", "additionalProperties": false, "required": ["body"],
      "properties": {
        "body": {"enum": ["roadster", "coupe", "pickup"]},
        "scale": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0.85, "maximum": 1.15}, "default": [1, 1, 1]},
        "stripeColor": {"$ref": "#/$defs/color"}, "accentColor": {"$ref": "#/$defs/color"}
      }
    },
    "car": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "color", "topSpeed", "cornering", "acceleration", "model"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "name": {"$ref": "#/$defs/name"}, "color": {"$ref": "#/$defs/color"},
        "topSpeed": {"type": "number", "minimum": 8, "maximum": 32},
        "cornering": {"type": "number", "minimum": 5, "maximum": 18},
        "acceleration": {"type": "number", "minimum": 2, "maximum": 10},
        "mass": {"type": "number", "minimum": 450, "maximum": 1200},
        "model": {"$ref": "#/$defs/carModel"}, "personality": {"$ref": "#/$defs/personality"}
      }
    },
    "collider": {
      "type": "object", "additionalProperties": false, "required": ["radius", "mass", "height"],
      "properties": {
        "radius": {"type": "number", "minimum": 0.25, "maximum": 8},
        "mass": {"type": "number", "minimum": 0.1, "maximum": 10000},
        "height": {"type": "number", "minimum": 0.2, "maximum": 12}
      }
    },
    "part": {
      "description": "Box size is [width,height,depth]. Sphere size is its ellipsoid radii [rx,ry,rz]. Cylinder size is [radiusTop,height,radiusBottom]. Positions and XYZ Euler rotations are local to the prop.",
      "type": "object", "additionalProperties": false, "required": ["shape", "size", "position", "color"],
      "properties": {
        "shape": {"enum": ["box", "sphere", "cylinder"]},
        "size": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 12}},
        "position": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": -12, "maximum": 12}},
        "rotation": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": -3.141592653589793, "maximum": 3.141592653589793}, "default": [0, 0, 0]},
        "color": {"$ref": "#/$defs/color"}
      }
    },
    "prop": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "collider", "parts"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "name": {"$ref": "#/$defs/name"}, "collider": {"$ref": "#/$defs/collider"},
        "kind": {"enum": ["custom", "building", "tree", "rock"], "default": "custom"},
        "parts": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/part"}}
      }
    }
  }
}
